# Turso: turso db show antidoto --url  /  turso db tokens create antidoto
TURSO_DATABASE_URL=libsql://antidoto-xxxx.turso.io
TURSO_AUTH_TOKEN=

# Solo para `npm run db:seed`: crea el primer superadmin (usuario, no correo). No se usa en runtime.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Ably (tiempo real del módulo en vivo): ably.com → tu app → API Keys. Usar la key con
# permisos de publish/subscribe/presence. Solo se lee en el servidor.
ABLY_API_KEY=
